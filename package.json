{
  "name": "overture",
  "displayName": "Overture",
  "description": "Orchestrate multiple app processes from a VS Code sidebar — terminals, profiles, logs, and auto-discovery.",
  "version": "1.1.0",
  "publisher": "thechandanbhagat",
  "repository": {
    "type": "git",
    "url": "https://github.com/thechandanbhagat/overture.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "resources/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.overture/config.json",
    "onView:overtureView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overture",
          "title": "Overture",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "overture": [
        {
          "id": "overtureView",
          "name": "Apps"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overtureView",
        "contents": "No .overture/config.json found in this workspace.\n\n[Create Config](command:overture.createConfig)\n\nOr manually create a .overture/config.json file.",
        "when": "overture.noConfig"
      },
      {
        "view": "overtureView",
        "contents": "Config created! Add apps to get started.\n\n[Scan for Projects](command:overture.scanProjects)\n\n[Open Config](command:overture.openConfig)",
        "when": "!overture.noConfig && overture.noApps"
      }
    ],
    "commands": [
      {
        "command": "overture.startAll",
        "title": "Start All Enabled Apps",
        "icon": "$(run-all)",
        "category": "Overture"
      },
      {
        "command": "overture.stopAll",
        "title": "Stop All Apps",
        "icon": "$(stop-circle)",
        "category": "Overture"
      },
      {
        "command": "overture.restartAll",
        "title": "Restart Running Apps",
        "icon": "$(debug-restart)",
        "category": "Overture"
      },
      {
        "command": "overture.selectNamespace",
        "title": "Filter by Namespace",
        "icon": "$(filter)",
        "category": "Overture"
      },
      {
        "command": "overture.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Overture"
      },
      {
        "command": "overture.openConfig",
        "title": "Open Config",
        "icon": "$(json)",
        "category": "Overture"
      },
      {
        "command": "overture.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)",
        "category": "Overture"
      },
      {
        "command": "overture.createConfig",
        "title": "Create Config",
        "icon": "$(new-file)",
        "category": "Overture"
      },
      {
        "command": "overture.scanProjects",
        "title": "Scan Workspace for Node.js Projects",
        "icon": "$(search-view-icon)",
        "category": "Overture"
      },
      {
        "command": "overture.startApp",
        "title": "Start App",
        "icon": "$(play)",
        "category": "Overture"
      },
      {
        "command": "overture.stopApp",
        "title": "Stop App",
        "icon": "$(debug-stop)",
        "category": "Overture"
      },
      {
        "command": "overture.restartApp",
        "title": "Restart App",
        "icon": "$(debug-restart)",
        "category": "Overture"
      },
      {
        "command": "overture.toggleEnable",
        "title": "Toggle Enable/Disable",
        "icon": "$(circle-slash)",
        "category": "Overture"
      },
      {
        "command": "overture.showOutput",
        "title": "Show Output",
        "icon": "$(output)",
        "category": "Overture"
      },
      {
        "command": "overture.createProfile",
        "title": "Create Profile",
        "icon": "$(add)",
        "category": "Overture"
      },
      {
        "command": "overture.startProfile",
        "title": "Start Profile",
        "icon": "$(play)",
        "category": "Overture"
      },
      {
        "command": "overture.stopProfile",
        "title": "Stop Profile",
        "icon": "$(debug-stop)",
        "category": "Overture"
      },
      {
        "command": "overture.editProfile",
        "title": "Edit Profile",
        "icon": "$(edit)",
        "category": "Overture"
      },
      {
        "command": "overture.toggleFavoriteProfile",
        "title": "Toggle Favorite",
        "icon": "$(star)",
        "category": "Overture"
      },
      {
        "command": "overture.deleteProfile",
        "title": "Delete Profile",
        "icon": "$(trash)",
        "category": "Overture"
      },
      {
        "command": "overture.toggleArchive",
        "title": "Archive / Unarchive App",
        "icon": "$(archive)",
        "category": "Overture"
      },
      {
        "command": "overture.revealInExplorer",
        "title": "Reveal in File Explorer",
        "icon": "$(folder-opened)",
        "category": "Overture"
      },
      {
        "command": "overture.toggleShowDisabledApps",
        "title": "Toggle Disabled Apps",
        "icon": "$(eye)",
        "category": "Overture"
      }
    ],
    "configuration": {
      "title": "Overture",
      "properties": {
        "overture.showDisabledApps": {
          "type": "boolean",
          "default": true,
          "description": "Show disabled apps in the Overture sidebar tree."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "overture.startAll",
          "when": "view == overtureView",
          "group": "navigation@1"
        },
        {
          "command": "overture.stopAll",
          "when": "view == overtureView",
          "group": "navigation@2"
        },
        {
          "command": "overture.refresh",
          "when": "view == overtureView",
          "group": "navigation@3"
        },
        {
          "command": "overture.openConfig",
          "when": "view == overtureView",
          "group": "navigation@4"
        },
        {
          "command": "overture.scanProjects",
          "when": "view == overtureView",
          "group": "navigation@5"
        },
        {
          "command": "overture.createProfile",
          "when": "view == overtureView",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "overture.startApp",
          "when": "view == overtureView && (viewItem == app-stopped || viewItem == app-error)",
          "group": "inline@1"
        },
        {
          "command": "overture.stopApp",
          "when": "view == overtureView && viewItem == app-running",
          "group": "inline@1"
        },
        {
          "command": "overture.restartApp",
          "when": "view == overtureView && viewItem == app-running",
          "group": "inline@2"
        },
        {
          "command": "overture.showOutput",
          "when": "view == overtureView && (viewItem == app-running || viewItem == app-stopped || viewItem == app-error)",
          "group": "inline@3"
        },
        {
          "command": "overture.toggleEnable",
          "when": "view == overtureView && (viewItem == app-disabled || viewItem == app-stopped || viewItem == app-running || viewItem == app-error)",
          "group": "inline@4"
        },
        {
          "command": "overture.startApp",
          "when": "view == overtureView && (viewItem == app-stopped || viewItem == app-error)",
          "group": "1_actions@1"
        },
        {
          "command": "overture.stopApp",
          "when": "view == overtureView && viewItem == app-running",
          "group": "1_actions@1"
        },
        {
          "command": "overture.restartApp",
          "when": "view == overtureView && viewItem == app-running",
          "group": "1_actions@2"
        },
        {
          "command": "overture.showOutput",
          "when": "view == overtureView && (viewItem == app-running || viewItem == app-stopped || viewItem == app-error)",
          "group": "2_view@1"
        },
        {
          "command": "overture.toggleEnable",
          "when": "view == overtureView",
          "group": "3_config@1"
        },
        {
          "command": "overture.startProfile",
          "when": "view == overtureView && (viewItem == profile || viewItem == profile-favorite)",
          "group": "inline@1"
        },
        {
          "command": "overture.stopProfile",
          "when": "view == overtureView && (viewItem == profile || viewItem == profile-favorite)",
          "group": "inline@2"
        },
        {
          "command": "overture.editProfile",
          "when": "view == overtureView && (viewItem == profile || viewItem == profile-favorite)",
          "group": "inline@3"
        },
        {
          "command": "overture.toggleFavoriteProfile",
          "when": "view == overtureView && (viewItem == profile || viewItem == profile-favorite)",
          "group": "inline@4"
        },
        {
          "command": "overture.deleteProfile",
          "when": "view == overtureView && (viewItem == profile || viewItem == profile-favorite)",
          "group": "inline@5"
        },
        {
          "command": "overture.createProfile",
          "when": "view == overtureView && (viewItem == section-profiles || viewItem == section-favorites)",
          "group": "inline@1"
        },
        {
          "command": "overture.toggleArchive",
          "when": "view == overtureView && (viewItem == app-stopped || viewItem == app-disabled || viewItem == app-error || viewItem == app-archived)",
          "group": "inline@5"
        },
        {
          "command": "overture.revealInExplorer",
          "when": "view == overtureView && (viewItem == app-detail-path || viewItem == app-folder || viewItem == app-file)",
          "group": "inline@1"
        }
      ],
      "terminal/context": [
        {
          "command": "overture.restartApp",
          "when": "overture.activeTerminalApp",
          "group": "overture@1"
        },
        {
          "command": "overture.stopApp",
          "when": "overture.activeTerminalApp",
          "group": "overture@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
